# Contact form email delivery (https://resend.com)
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# Without these, the contact form prints messages to the server console in development
# and shows an error asking visitors to email/WhatsApp instead in production.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="MP Tecc Website <website@mptecc.com>"
CONTACT_TO_EMAIL=info@mptecc.com
